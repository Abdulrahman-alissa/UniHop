PORT=4000
# Local: postgresql://postgres:postgres@localhost:5432/unihop
# Hosted (Render/Neon/Supabase): paste the external connection string (TLS is enabled automatically for sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/unihop
DATABASE_SSL=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Comma-separated frontend origins allowed by CORS. "*" allows any (dev only).
CORS_ORIGIN=http://localhost:5173
# Insert demo users/rides when the database is empty
AUTO_SEED=true
